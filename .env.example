# Django
SECRET_KEY=genera_una_clave_larga_y_aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio-api.com
CORS_ALLOWED_ORIGINS=https://mysazonova.com,https://www.mysazonova.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://mysazonova.com,https://www.mysazonova.com

# PostgreSQL (usado por docker-compose)
POSTGRES_DB=sazonova
POSTGRES_USER=sazonova
