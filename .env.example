POSTGRES_PORT=5432

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
WEB_PORT=8000

# Media (True si no usas nginx/CDN para /media/)
SERVE_MEDIA=True

# Brevo
BREVO_API_KEY=tu_api_key_de_brevo
